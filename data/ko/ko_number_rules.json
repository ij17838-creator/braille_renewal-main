{
  "schema_version": "1.0",
  "system": "korean_braille",
  "module": "numeric_syntax_parser",
  "initiator_condition": {
    "requires_prefix": true,
    "prefix_id": "num_prefix",
    "description": "수표(⠼) 뒤에 오는 점형만 숫자로 해석"
  },
  "symbols": {
    "comma": {
      "char": ",",
      "name": "자릿수 쉼표",
      "dots": [[2]],
      "unicode": "⠂",
      "persists_numeric_mode": true
    },
    "period": {
      "char": ".",
      "name": "소수점",
      "dots": [[2, 5, 6]],
      "unicode": "⠲",
      "persists_numeric_mode": true
    },
    "hyphen": {
      "char": "-",
      "name": "하이픈",
      "dots": [[3, 6]],
      "unicode": "⠤",
      "persists_numeric_mode": true
    },
    "fraction_slash": {
      "char": "/",
      "name": "단순 분수선",
      "dots": [[3, 4]],
      "unicode": "⠌",
      "persists_numeric_mode": true
    }
  },
  "scope_maintenance": {
    "persists_across_connectors": ["comma", "period", "hyphen", "fraction_slash"],
    "description": "쉼표·소수점·하이픈·분수선으로 연결된 숫자는 수표를 다시 붙이지 않고 연속 유지됨. 점형은 symbols가 기준이다. 띄어쓰기는 연결자가 아니며 숫자 입력을 끝낸다."
  },
  "termination_triggers": {
    "terminators": [
      "space",
      "korean_letter",
      "punctuation_standalone",
      "line_break"
    ],
    "description": "띄어쓰기가 숫자 입력을 종료한다. 줄바꿈과 문장부호도 수표 효력을 끝낸다."
  },
  "collision_resolutions": {
    "korean_syllables": {
      "rule": "수표 모드 내에서는 한글 초성 점형(예: 'ㄴ', 'ㄷ' 등)과 겹치더라도 숫자가 우선 파싱됨"
    },
    "trailing_letters": {
      "rule": "숫자와 점형이 겹치는 초성 ㄴ·ㄷ·ㅁ·ㅋ·ㅌ·ㅍ·ㅎ이나 약자 운이 바로 이어지면 띄어쓰기로 수표 효력을 끝낸다. 그 사이에는 1급 점자표를 넣지 않는다.",
      "exempt_units": [
        "년",
        "월",
        "일",
        "시",
        "분",
        "초",
        "동",
        "호",
        "층",
        "개",
        "명",
        "원",
        "미터",
        "킬로미터",
        "센티미터",
        "밀리미터",
        "그램",
        "킬로그램",
        "리터",
        "밀리리터"
      ],
      "exempt_rule_description": "한국 점자 규정: 수표 뒤에 단위어가 이어 나올 때는 띄어쓰지 않고 붙여 적는다. 파서와 검사기는 이 목록과 unit_boundary를 함께 읽는다.",
      "unit_boundary": {
        "enabled": true,
        "rule": "숫자 뒤 단위 후보는 그 직후가 토큰 경계이거나 조사일 때만 단위로 인정한다. 조사가 아닌 한글 음절이 바로 이어지면 단위 매칭을 취소하고 일반 어휘로 본다. 예: 5동에(동+에)는 단위, 5동안(동+안)은 단위가 아니다.",
        "josa": [
          "에게서",
          "한테서",
          "이든지",
          "이라도",
          "이나마",
          "이라고",
          "에서",
          "에게",
          "께서",
          "으로",
          "부터",
          "까지",
          "보다",
          "처럼",
          "같이",
          "마다",
          "밖에",
          "조차",
          "마저",
          "이랑",
          "하고",
          "이나",
          "라도",
          "이든",
          "만큼",
          "대로",
          "든지",
          "이야",
          "나마",
          "한테",
          "커녕",
          "라고",
          "이",
          "가",
          "을",
          "를",
          "은",
          "는",
          "의",
          "에",
          "로",
          "와",
          "과",
          "도",
          "만",
          "께",
          "야",
          "아",
          "나",
          "랑",
          "뿐",
          "든"
        ]
      },
      "roman_unit_symbols": {
        "m": "⠍",
        "km": "⠅⠍",
        "cm": "⠉⠍",
        "mm": "⠍⠍",
        "kg": "⠅⠛",
        "g": "⠛",
        "l": "⠇",
        "ml": "⠍⠇"
      },
      "roman_unit_rule_description": "한국 점자 규정: 숫자 바로 뒤에 오는 로마자 단위 기호는 로마자표(⠴) 없이 소문자 점형을 숫자에 바로 이어 적음"
    }
  }
}