{
  "units": [
    {
      "id": "ko-dots",
      "lang": "ko",
      "order": 1,
      "part": "점자 기초",
      "title": "점의 자리",
      "teach": {
        "letter": "점",
        "pattern": "⠿",
        "dots": [1, 2, 3, 4, 5, 6],
        "line": "한 칸은 왼쪽 1·2·3점, 오른쪽 4·5·6점입니다."
      },
      "source": {
        "kind": "static",
        "cards": [
          { "letter": "1", "pattern": "⠁", "dots": [1], "line": "왼쪽 위는 1점입니다." },
          { "letter": "2", "pattern": "⠂", "dots": [2], "line": "왼쪽 가운데는 2점입니다." },
          { "letter": "3", "pattern": "⠄", "dots": [3], "line": "왼쪽 아래는 3점입니다." },
          { "letter": "4", "pattern": "⠈", "dots": [4], "line": "오른쪽 위는 4점입니다." },
          { "letter": "5", "pattern": "⠐", "dots": [5], "line": "오른쪽 가운데는 5점입니다." },
          { "letter": "6", "pattern": "⠠", "dots": [6], "line": "오른쪽 아래는 6점입니다." }
        ]
      },
      "skill": {
        "read": "점 번호를 보고 칸의 자리를 찾는다",
        "write": "번호를 듣고 그 점만 찍는다"
      },
      "materials": {
        "hwpx": "materials/ko/ko-dots.hwpx",
        "pdf": "materials/ko/ko-dots.pdf"
      }
    },
