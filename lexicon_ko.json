{
  "entry_schema": {
    "description": "example_stems와 contrasting_rules.examples는 같은 base를 뜻별로 가를 수 있다. meaning과 sense_id는 선택이며, 없으면 단일 활용이다.",
    "example_stems": {
      "required": ["base"],
      "optional": ["vowel_trigger", "transformed", "example", "meaning", "sense_id", "aliases"]
    },
    "contrasting_examples": {
      "required": ["base"],
      "optional": ["example", "meaning", "sense_id", "aliases"]
    }
  },
  "irregular_rules": {
    "digeut": {
      "name": "ㄷ 불규칙",
      "target_final_consonant": "ㄷ",
      "trigger_condition": {
        "following_starts_with": "vowel"
      },
      "transformation": {
        "final_consonant_changes_to": "ㄹ",
        "example_stems": [
          { "base": "듣", "vowel_trigger": "들", "example": "듣다 -> 들어요 / 들으면" },
          { "base": "걷", "vowel_trigger": "걸", "sense_id": "geot-walk", "meaning": "walk", "aliases": ["길을 가다"], "example": "걷다 -> 걸어요 / 걸으면 (길을 가다)" },
          { "base": "묻", "vowel_trigger": "물", "sense_id": "mut-ask", "meaning": "ask", "aliases": ["질문하다"], "example": "묻다 -> 물어요 (질문하다)" },
          { "base": "깨닫", "vowel_trigger": "깨달", "example": "깨닫다 -> 깨달아 / 깨달으면" }
        ],
        "contrasting_rules": {
          "compare_with_regular": {
            "name": "규칙 활용",
            "mechanism": "같은 철자라도 의미가 다르면 받침 ㄷ을 ㄹ로 바꾸지 않는다",
            "examples": [
              { "base": "걷", "sense_id": "geot-roll", "meaning": "roll", "aliases": ["소매를 걷다"], "example": "걷다 -> 걷어요 (소매 등을 올리다)" },
              { "base": "묻", "sense_id": "mut-bury", "meaning": "bury", "aliases": ["흙 속에 넣다"], "example": "묻다 -> 묻어요 (흙 속에 넣다)" }
            ]
          }
        },
        "regular_exceptions": [
          { "base": "받", "example": "받다 -> 받아요 / 받으면" },
          { "base": "닫", "example": "닫다 -> 닫아요 / 닫으면" },
          { "base": "믿", "example": "믿다 -> 믿어요 / 믿으면" },
          { "base": "얻", "example": "얻다 -> 얻어 / 얻으면" }
        ]
      }
    },
    "bieup": {
      "name": "ㅂ 불규칙",
      "target_final_consonant": "ㅂ",
      "trigger_condition": {
        "following_starts_with": "vowel"
      },
      "transformation": {
        "final_consonant_drops": true,
        "inserted_vowel": {
          "default": "우",
          "yang_vowel_monosyllabic_exception": {
            "condition": "'-아/어' 앞에서 '오'가 되는 것은 돕다·곱다뿐이다. 아름답다처럼 ㅏ가 들어 있어도 '워'가 된다. '-(으)' 앞에서는 돕다·곱다도 '우'이다",
            "inserted_vowel": "오",
            "examples": [
              { "base": "돕", "with_ah": "도와", "with_eumyeon": "도우면" },
              { "base": "곱", "with_ah": "고와", "with_eumyeon": "고우면" }
            ]
          }
        },
        "eu_absorption": {
          "description": "'-(으)면', '-(으)니' 등의 매개모음 '으'와 만날 때 'ㅂ'이 탈락하고 '우'로 대체됨",
          "formula": "어간(ㅂ 탈락) + 우 + 어미(자음)"
        },
        "regular_exceptions": [
          { "base": "잡", "example": "잡다 -> 잡아요 / 잡으면" },
          { "base": "뽑", "example": "뽑다 -> 뽑아요 / 뽑으면" },
          { "base": "입", "example": "입다 -> 입어요 / 입으면" },
          { "base": "좁", "example": "좁다 -> 좁아요 / 좁으면" },
          { "base": "집", "example": "집다 -> 집어요 / 집으면" },
          { "base": "씹", "example": "씹다 -> 씹어요 / 씹으면" },
          { "base": "접", "example": "접다 -> 접어요 / 접으면" }
        ]
      }
    },
    "siot": {
      "name": "ㅅ 불규칙",
      "target_final_consonant": "ㅅ",
      "trigger_condition": {
        "following_starts_with": "vowel"
      },
      "transformation": {
        "final_consonant_drops": true,
        "vowel_contraction_blocked": true,
        "description": "받침 'ㅅ'은 탈락하지만 모음끼리 축약되지 않고 독립된 음절을 유지함",
        "example_stems": [
          { "base": "짓", "transformed": "지", "example": "짓다 -> 지어 / 지으면 (져 X)" },
          { "base": "낫", "transformed": "나", "example": "낫다 -> 나아 / 나으면 (한 음절 '나'로 줄이지 않음)" },
          { "base": "붓", "transformed": "부", "example": "붓다 -> 부어 / 부으면 (붜 X)" }
        ],
        "regular_exceptions": [
          { "base": "벗", "example": "벗다 -> 벗어요 / 벗으면" },
          { "base": "웃", "example": "웃다 -> 웃어요 / 웃으면" },
          { "base": "씻", "example": "씻다 -> 씻어요 / 씻으면" },
          { "base": "빼앗", "example": "빼앗다 -> 빼앗아요 / 빼앗으면" },
          { "base": "솟", "example": "솟다 -> 솟아요 / 솟으면" },
          { "base": "빗", "example": "빗다 -> 빗어요 / 빗으면" }
        ]
      }
    },
    "reu": {
      "name": "르 불규칙",
      "target_syllable": "르",
      "trigger_condition": {
        "following_eomi": "-아/-어 계열 어미"
      },
      "transformation": {
        "eu_drops": true,
        "add_rieul_batchim_to_previous_syllable": true,
        "following_vowel_added": "ㄹ + 아/어",
        "description": "어간 끝 '르'의 'ㅡ'가 탈락하고, 앞 음절에 종성 'ㄹ'이 붙으며 뒤에는 '라/러'가 결합",
        "example_stems": [
          { "base": "모르", "example": "모르다 -> 몰라 / 몰라서" },
          { "base": "빠르", "example": "빠르다 -> 빨라 / 빨라서" },
          { "base": "부르", "example": "부르다 -> 불러 / 불러서" },
          { "base": "흐르", "example": "흐르다 -> 흘러 / 흘러서" },
          { "base": "이르", "vowel_trigger": "일ㄹ", "sense_id": "ireu-tell", "meaning": "tell", "aliases": ["말하다"], "example": "이르다 -> 일러 / 일러서 (말하다)" }
        ],
        "contrasting_rules": {
          "compare_with_leobeulgyuchik": {
            "name": "러 불규칙",
            "mechanism": "어간의 '르'는 유지되고 어미 '-어'가 '-러'로 바뀜",
            "examples": [
              { "base": "이르", "sense_id": "ireu-arrive", "meaning": "arrive", "aliases": ["도착하다"], "example": "이르다 -> 이르러" },
              { "base": "푸르", "meaning": "색상", "example": "푸르다 -> 푸르러" }
            ]
          }
        }
      }
    },
    "eu_drop": {
      "name": "ㅡ 탈락 (규칙적 음운 변동)",
      "target_vowel": "ㅡ",
      "trigger_condition": {
        "following_starts_with": "vowel"
      },
      "transformation": {
        "stem_final_vowel_drops": true,
        "vowel_harmony_determined_by": "어간 'ㅡ' 바로 앞 음절의 모음. ㅏ·ㅑ·ㅗ·ㅛ이면 '아', 그 밖이거나 앞 음절이 없으면 '어'",
        "example_stems": [
          { "base": "바쁘", "preceding_vowel": "ㅏ (양성)", "example": "바쁘다 -> 바빠 (바ㅃ + 아)" },
          { "base": "예쁘", "preceding_vowel": "ㅖ (음성)", "example": "예쁘다 -> 예뻐 (예ㅃ + 어)" },
          { "base": "크", "preceding_vowel": null, "example": "크다 -> 커 (ㅋ + 어)" },
          { "base": "쓰", "preceding_vowel": null, "example": "쓰다 -> 써 (ㅆ + 어)" }
        ]
      }
    },
    "rieul_drop": {
      "name": "ㄹ 탈락 (규칙적 음운 변동)",
      "target_final_consonant": "ㄹ",
      "trigger_condition": {
        "rieul_drops_before": ["ㄴ", "ㅂ", "ㅅ", "오"],
        "single_rieul_before_rieul_ending": "어미 '-ㄹ' 앞에서는 ㄹ이 겹치지 않고 하나 남는다 (살 + -ㄹ → 살)",
        "filler_eu_only": "'-(으)면'처럼 매개모음 '으'만 빠지는 어미 앞에서는 ㄹ이 남는다"
      },
      "transformation": {
        "final_consonant_drops_before_nieun_bieup_siot_o": true,
        "filler_eu_drops_and_rieul_stays": true,
        "example_stems": [
          { "base": "살", "with_ni": "사니", "with_b_nida": "삽니다", "with_si": "사시다", "with_myeon": "살면" },
          { "base": "알", "with_neun": "아는", "with_b_nida": "압니다", "with_so": "아오", "with_myeon": "알면" },
          { "base": "만들", "with_si": "만드시-", "with_b_nida": "만듭니다", "with_neun": "만드는" }
        ]
      }
    },
    "yeo": {
      "name": "여 불규칙 (하다 불규칙)",
      "target_stem": "하",
      "trigger_condition": {
        "following_eomi": "-아/-어 계열 어미"
      },
      "transformation": {
        "eomi_changes_to": "여",
        "contraction": "하여 -> 해",
        "example": "하다 -> 하여 / 해"
      }
    },
    "hieut": {
      "name": "ㅎ 불규칙",
      "target_final_consonant": "ㅎ",
      "trigger_condition": {
        "vowel_eomi": "-아/-어 결합 시 또는 '-(으)' 매개모음 결합 시"
      },
      "transformation": {
        "with_eu_vowel": "ㅎ이 빠지고 매개모음 으도 빠진다 (파랗다 + 으면 -> 파라면)",
        "with_ah_uh_vowel": "ㅎ이 빠지며 모음이 바뀐다. ㅏ·ㅓ·ㅗ·ㅜ·ㅡ·ㅣ 계열은 ㅐ (파래, 그래, 노래, 누레), ㅑ는 ㅒ (하얗다 + 아 -> 하얘), ㅕ는 ㅖ (허옇다 + 어 -> 허예)"
      },
      "regular_exceptions": [
        { "base": "좋", "example": "좋다 -> 좋아 / 좋으면" },
        { "base": "놓", "example": "놓다 -> 놓아 / 놓으면" },
        { "base": "넣", "example": "넣다 -> 넣어 / 넣으면" }
      ]
    }
  }
}