{
  "schema_version": "1.0",
  "system": "korean_braille",
  "module": "numeric_syntax_parser",
  "initiator_condition": {
    "requires_prefix": true,
    "prefix_id": "num_prefix",
    "description": "수표(⠼) 뒤에 오는 점형만 숫자로 해석"
  },
  "symbols": {
    "comma": {
      "char": ",",
      "name": "자릿수 쉼표",
      "dots": [[2]],
      "unicode": "⠂",
      "persists_numeric_mode": true
    },
    "period": {
      "char": ".",
      "name": "소수점",
      "dots": [[2, 5, 6]],
      "unicode": "⠲",
      "persists_numeric_mode": true
    },
    "hyphen": {
      "char": "-",
      "name": "하이픈",
      "dots": [[3, 6]],
      "unicode": "⠤",
      "persists_numeric_mode": true
    },
    "fraction_slash": {
      "char": "/",
      "name": "단순 분수선",
      "dots": [[3, 4]],
      "unicode": "⠌",
      "persists_numeric_mode": true
    },
    "numeric_space": {
      "char": " ",
      "name": "숫자 빈칸",
      "dots": [[5]],
      "unicode": "⠐",
      "persists_numeric_mode": true
    }
  },
  "scope_maintenance": {
    "persists_across_connectors": ["comma", "period", "hyphen", "fraction_slash", "numeric_space"],
    "description": "한국어 규정상 쉼표·소수점·하이픈·분수선으로 연결된 숫자는 수표를 다시 붙이지 않고 연속 유지됨. 점형은 symbols가 기준이다."
  },
  "termination_triggers": {
    "terminators": [
      "space",
      "korean_letter",
      "alphabet_indicator",
      "punctuation_standalone",
      "line_break"
    ],
    "description": "빈칸, 한글 초성/중성 점자, 영문 기호표 등을 만났을 때 수표 효력 종료"
  },
  "collision_resolutions": {
    "korean_syllables": {
      "rule": "수표 모드 내에서는 한글 초성 점형(예: 'ㄴ', 'ㄷ' 등)과 겹치더라도 숫자가 우선 파싱됨"
    },
    "trailing_letters": {
      "rule": "숫자 바로 뒤에 영문 또는 한글이 이어질 경우, 각각 언어 기호표나 띄어쓰기를 통해 구문 분리",
      "exempt_units": [
        "년",
        "월",
        "일",
        "시",
        "분",
        "초",
        "동",
        "호",
        "층",
        "개",
        "명",
        "원",
        "미터",
        "킬로미터",
        "센티미터",
        "밀리미터",
        "그램",
        "킬로그램",
        "리터",
        "밀리리터"
      ],
      "exempt_rule_description": "한국 점자 규정 제17항: 수표 뒤에 단위어가 이어 나올 때는 1급 기호표(⠰)를 적지 아니한다. 파서와 검사기는 이 목록만 읽는다.",
      "roman_unit_symbols": {
        "m": "⠍",
        "km": "⠅⠍",
        "cm": "⠉⠍",
        "mm": "⠍⠍",
        "kg": "⠅⠛",
        "g": "⠛",
        "l": "⠇",
        "ml": "⠍⠇"
      },
      "roman_unit_rule_description": "한국 점자 규정: 숫자 바로 뒤에 오는 로마자 단위 기호는 로마자표(⠴) 없이 소문자 점형을 숫자에 바로 이어 적음"
    }
  }
}