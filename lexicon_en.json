{
  "pipeline_order": [
    "inflectional_suffix",
    "derivational_suffix",
    "root",
    "prefix"
  ],

  "prefixes": {
    "category": "prefix",
    "description": "어근 앞에 결합하는 주요 접두사 목록 및 음절 경계 분리 규칙",
    "rule": {
      "position": "initial",
      "boundaryCheck": true,
      "priority": 60
    },
    "items": {
      "un": { "morpheme": "un", "type": "negative" },
      "re": { "morpheme": "re", "type": "again_or_back" },
      "pre": { "morpheme": "pre", "type": "locative_temporal" },
      "non": { "morpheme": "non", "type": "negative" },
      "anti": { "morpheme": "anti", "type": "oppositional" },
      "mis": { "morpheme": "mis", "type": "incorrect" },
      "over": { "morpheme": "over", "type": "excessive_or_above" },
      "under": { "morpheme": "under", "type": "insufficient_or_below" },
      "sub": { "morpheme": "sub", "type": "locative" },
      "trans": { "morpheme": "trans", "type": "across_or_change" },
      "inter": { "morpheme": "inter", "type": "relational" },
      "semi": { "morpheme": "semi", "type": "degree" }
    }
  },

  "inflectional_suffixes": {
    "category": "inflectional_suffix",
    "description": "문법적 관계를 나타내는 굴절 어미 및 결합 속성",
    "rule": {
      "position": "final_outer",
      "affectsStem": true,
      "priority": 80
    },
    "items": {
      "s": {
        "morpheme": "s",
        "grammar": "plural_or_3rd_singular"
      },
      "es": {
        "morpheme": "es",
        "grammar": "plural_or_3rd_singular"
      },
      "ed": {
        "morpheme": "ed",
        "grammar": "past_or_past_participle"
      },
      "ing": {
        "morpheme": "ing",
        "grammar": "present_participle_or_gerund"
      },
      "er": {
        "morpheme": "er",
        "grammar": "comparative"
      },
      "est": {
        "morpheme": "est",
        "grammar": "superlative"
      }
    }
  },

  "derivational_suffixes": {
    "category": "derivational_suffix",
    "description": "품사를 전환하거나 의미를 확장하는 파생 어미(기존 점자 약어에 없는 형태소 중심)",
    "rule": {
      "position": "final_inner",
      "affectsStem": true,
      "priority": 70
    },
    "items": {
      "able": { "morpheme": "able", "targetPos": "adjective" },
      "ible": { "morpheme": "ible", "targetPos": "adjective" },
      "ful": { "morpheme": "ful", "targetPos": "adjective_or_noun" },
      "ish": { "morpheme": "ish", "targetPos": "adjective" },
      "ist": { "morpheme": "ist", "targetPos": "noun" },
      "ism": { "morpheme": "ism", "targetPos": "noun" },
      "ize": { "morpheme": "ize", "targetPos": "verb" },
      "ise": { "morpheme": "ise", "targetPos": "verb" },
      "ship": { "morpheme": "ship", "targetPos": "noun" },
      "hood": { "morpheme": "hood", "targetPos": "noun" },
      "dom": { "morpheme": "dom", "targetPos": "noun" },
      "ly": { "morpheme": "ly", "targetPos": "adverb_or_adjective" }
    }
  },

  "roots": {
    "category": "root",
    "description": "다양한 접사와 결합하는 기본 어근 및 형태소 분리 속성",
    "rule": {
      "position": "base",
      "priority": 50
    },
    "items": {
      "act": {
        "stem": "act",
        "pos": ["verb", "noun"],
        "allowPrefix": true,
        "allowSuffix": true,
        "hasSilentE": false,
        "doubleConsonantAllowed": false
      },
      "form": {
        "stem": "form",
        "pos": ["verb", "noun"],
        "allowPrefix": true,
        "allowSuffix": true,
        "hasSilentE": false,
        "doubleConsonantAllowed": false
      },
      "port": {
        "stem": "port",
        "pos": ["verb", "noun"],
        "allowPrefix": true,
        "allowSuffix": true,
        "hasSilentE": false,
        "doubleConsonantAllowed": false
      },
      "struct": {
        "stem": "struct",
        "pos": ["bound_root"],
        "gloss": "build",
        "allowPrefix": true,
        "allowSuffix": true,
        "hasSilentE": false,
        "doubleConsonantAllowed": false
      },
      "tract": {
        "stem": "tract",
        "pos": ["bound_root"],
        "gloss": "pull",
        "allowPrefix": true,
        "allowSuffix": true,
        "hasSilentE": false,
        "doubleConsonantAllowed": false
      },
      "press": {
        "stem": "press",
        "pos": ["verb", "noun"],
        "allowPrefix": true,
        "allowSuffix": true,
        "hasSilentE": false,
        "doubleConsonantAllowed": false
      },
      "play": {
        "stem": "play",
        "pos": ["verb", "noun"],
        "allowPrefix": true,
        "allowSuffix": true,
        "hasSilentE": false,
        "doubleConsonantAllowed": false
      },
      "help": {
        "stem": "help",
        "pos": ["verb", "noun"],
        "allowPrefix": true,
        "allowSuffix": true,
        "hasSilentE": false,
        "doubleConsonantAllowed": false
      },
      "care": {
        "stem": "care",
        "pos": ["verb", "noun"],
        "allowPrefix": true,
        "allowSuffix": true,
        "hasSilentE": true,
        "doubleConsonantAllowed": false
      },
      "hope": {
        "stem": "hope",
        "pos": ["verb", "noun"],
        "allowPrefix": true,
        "allowSuffix": true,
        "hasSilentE": true,
        "doubleConsonantAllowed": false
      }
    }
  },

  "combining_rules": {
    "bridge_rule": {
      "description": "형태소 경계를 가로지르는 점자 약어(묶음약자) 생성 금지 규칙",
      "disallowCrossMorphemeContraction": true,
      "scope": {
        "prefixToRoot": true,
        "rootToDerivationalSuffix": true,
        "derivationalToInflectionalSuffix": true
      },
      "allowExceptions": false
    },
    "spelling_transformations": {
      "drop_silent_e": {
        "triggerSuffixes": ["ing", "ed", "er", "est", "able", "ible", "ish", "ist", "ism", "ize", "ise"],
        "requiresStemProperty": "hasSilentE",
        "action": "remove_last_letter",
        "keepSilentE": {
          "whenStemEndsWith": ["ce", "ge"],
          "beforeSuffixes": ["able", "ous"]
        }
      },
      "double_final_consonant": {
        "triggerSuffixes": ["ing", "ed", "er", "est"],
        "pattern": "[^aeiou][aeiou][bcdfghjklmnpqrstvz]$",
        "excludedEndings": ["w", "x", "y"],
        "requiresStemProperty": "doubleConsonantAllowed",
        "requiresStress": "monosyllable_or_stressed_final_syllable",
        "quCountsAsOnset": true,
        "action": "duplicate_last_consonant",
        "finalC": {
          "ending": "c",
          "action": "insert_k_before_suffix"
        }
      },
      "y_to_i": {
        "triggerSuffixes": ["es", "ed", "er", "est", "able", "ly", "ful"],
        "pattern": "[^aeiou]y$",
        "action": "replace_y_with_i",
        "keepY": {
          "monosyllableBeforeSuffixes": ["ly"]
        }
      }
    }
  }
}